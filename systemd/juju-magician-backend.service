[Unit]
Description=Juju Magician Backend API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/trung.thanh.phan@canonical.com/personal/magician/backend
Environment="FLASK_DEBUG=true"
ExecStart=/home/trung.thanh.phan@canonical.com/personal/magician/backend/venv/bin/python app.py
Restart=always
RestartSec=3

# Output to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=juju-magician-backend

[Install]
WantedBy=multi-user.target
