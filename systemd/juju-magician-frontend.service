[Unit]
Description=Juju Magician Frontend (Vite Dev Server)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/trung.thanh.phan@canonical.com/personal/magician/frontend
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=3

# Output to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=juju-magician-frontend

[Install]
WantedBy=multi-user.target
