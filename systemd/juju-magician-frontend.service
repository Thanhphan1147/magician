[Unit]
Description=Juju Magician Frontend (Vite Dev Server)
After=network.target

[Service]
Type=simple
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=NVM_DIR=/home/ubuntu/.nvm
WorkingDirectory=/home/trung.thanh.phan@canonical.com/personal/magician/frontend
ExecStart=/bin/bash -lc "source \"$NVM_DIR/nvm.sh\" && nvm use --silent default && npm run dev"
Restart=always
RestartSec=3

# Output to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=juju-magician-frontend

[Install]
WantedBy=multi-user.target
